        "from sklearn.metrics import (\n",
        "    accuracy_score,\n",
        "    f1_score,\n",
        "    precision_score,\n",
        "    recall_score,\n",
        ")\n",
        "\n",
        "def evaluar(nombre, y_real, y_pred):\n",
        "    return {\n",
        "        \"Método\": nombre,\n",
        "        \"Exactitud\": accuracy_score(y_real, y_pred),\n",
        "        \"Precisión (reprobado)\": precision_score(y_real, y_pred, zero_division=0),\n",
        "        \"Sensibilidad (reprobado)\": recall_score(y_real, y_pred, zero_division=0),\n",
        "        \"F1 (reprobado)\": f1_score(y_real, y_pred, zero_division=0),\n",
        "    }\n",
        "\n",
        "clase_mayoritaria = y_ent.mode().iat[0]\n",
        "pred_mayoritaria = pd.Series(clase_mayoritaria, index=y_val.index)\n",
        "pred_regla_g2 = X_val[\"G2\"].lt(NOTA_MINIMA).astype(int)\n",
        "\n",
        "resultados_validacion = pd.DataFrame([\n",
        "    evaluar(\"Clase mayoritaria\", y_val, pred_mayoritaria),\n",
        "    evaluar(\"Regla G2 < 10\", y_val, pred_regla_g2),\n",
        "]).set_index(\"Método\")\n",
        "\n",
        "display(resultados_validacion.round(3))"
