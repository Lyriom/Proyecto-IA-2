        "from sklearn.model_selection import train_test_split\n",
        "\n",
        "X_ent, X_resto, y_ent, y_resto = train_test_split(\n",
        "    X, y, test_size=0.40, stratify=y, random_state=SEMILLA\n",
        ")\n",
        "\n",
        "X_val, X_prueba, y_val, y_prueba = train_test_split(\n",
        "    X_resto, y_resto, test_size=0.50, stratify=y_resto, random_state=SEMILLA\n",
        ")\n",
        "\n",
        "particiones = {\n",
        "    \"Entrenamiento\": y_ent,\n",
        "    \"Validación\": y_val,\n",
        "    \"Prueba\": y_prueba,\n",
        "}\n",
        "\n",
        "display(pd.DataFrame([\n",
        "    {\n",
        "        \"Partición\": nombre,\n",
        "        \"Estudiantes\": len(etiquetas),\n",
        "        \"Aprobados\": int(etiquetas.eq(0).sum()),\n",
        "        \"Reprobados\": int(etiquetas.eq(1).sum()),\n",
        "        \"% reprobados\": round(100 * etiquetas.mean(), 2),\n",
        "    }\n",
        "    for nombre, etiquetas in particiones.items()\n",
        "]))"
