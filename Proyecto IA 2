        "from pathlib import Path\n",
        "from tempfile import TemporaryDirectory\n",
        "\n",
        "import numpy as np\n",
        "import tensorflow as tf\n",
        "from tensorflow import keras\n",
        "\n",
        "keras.utils.set_random_seed(SEMILLA)\n",
        "\n",
        "X_ent_red = X_ent.to_numpy(dtype=\"float32\") / NOTA_MAXIMA\n",
        "X_val_red = X_val.to_numpy(dtype=\"float32\") / NOTA_MAXIMA\n",
        "\n",
        "modelo = keras.Sequential([\n",
        "    keras.Input(shape=(X_ent_red.shape[1],), name=\"notas\"),\n",
        "    keras.layers.Dense(8, activation=\"relu\", name=\"capa_oculta\"),\n",
        "    keras.layers.Dense(1, activation=\"sigmoid\", name=\"probabilidad_reprobacion\"),\n",
        "])\n",
        "\n",
        "modelo.compile(\n",
        "    optimizer=keras.optimizers.Adam(learning_rate=0.001),\n",
        "    loss=\"binary_crossentropy\",\n",
        ")\n",
        "\n",
        "with TemporaryDirectory() as carpeta:\n",
        "    ruta_pesos = Path(carpeta) / \"mejor_modelo.weights.h5\"\n",
        "\n",
        "    guardar_mejor = keras.callbacks.ModelCheckpoint(\n",
        "        filepath=str(ruta_pesos),\n",
        "        monitor=\"val_loss\",\n",
        "        mode=\"min\",\n",
        "        save_best_only=True,\n",
        "        save_weights_only=True,\n",
        "    )\n",
        "\n",
        "    historial = modelo.fit(\n",
        "        X_ent_red,\n",
        "        y_ent.to_numpy(dtype=\"float32\"),\n",
        "        validation_data=(X_val_red, y_val.to_numpy(dtype=\"float32\")),\n",
        "        epochs=100,\n",
        "        batch_size=16,\n",
        "        callbacks=[guardar_mejor],\n",
        "        verbose=0,\n",
        "    )\n",
        "\n",
        "    modelo.load_weights(str(ruta_pesos))\n",
        "\n",
        "perdida_val = historial.history[\"val_loss\"]\n",
        "mejor_epoca = int(np.argmin(perdida_val)) + 1\n",
        "\n",
        "print(f\"TensorFlow {tf.__version__} | Semilla: {SEMILLA}\")\n",
        "print(f\"Mejor época: {mejor_epoca} de {len(perdida_val)}\")\n",
        "print(f\"Pérdida de validación en esa época: {perdida_val[mejor_epoca - 1]:.4f}\")"
