        "from io import BytesIO\n",
        "from pathlib import PurePosixPath\n",
        "from zipfile import ZipFile\n",
        "\n",
        "import pandas as pd\n",
        "from google.colab import files\n",
        "from IPython.display import display\n",
        "\n",
        "SEMILLA = 42\n",
        "NOTA_MINIMA = 10\n",
        "NOTA_MAXIMA = 20\n",
        "\n",
        "\n",
        "def buscar_csv_portugues(contenido_zip):\n",
        "    \"\"\"Busca student-por.csv, incluso dentro de otro ZIP.\"\"\"\n",
        "    with ZipFile(BytesIO(contenido_zip)) as archivo_zip:\n",
        "        rutas = archivo_zip.namelist()\n",
        "\n",
        "        for ruta in rutas:\n",
        "            if PurePosixPath(ruta).name == \"student-por.csv\":\n",
        "                return archivo_zip.read(ruta)\n",
        "\n",
        "        for ruta in rutas:\n",
        "            if ruta.lower().endswith(\".zip\"):\n",
        "                contenido_csv = buscar_csv_portugues(archivo_zip.read(ruta))\n",
        "                if contenido_csv is not None:\n",
        "                    return contenido_csv\n",
        "\n",
        "    return None\n",
        "\n",
        "\n",
        "archivos = files.upload()\n",
        "if len(archivos) != 1:\n",
        "    raise ValueError(\"Sube un solo archivo: el ZIP de UCI o student-por.csv.\")\n",
        "\n",
        "nombre, contenido = next(iter(archivos.items()))\n",
        "\n",
        "if nombre.lower().endswith(\".zip\"):\n",
        "    contenido = buscar_csv_portugues(contenido)\n",
        "    if contenido is None:\n",
        "        raise ValueError(\"No se encontró student-por.csv dentro del ZIP.\")\n",
        "    nombre = \"student-por.csv\"\n",
        "elif not nombre.lower().endswith(\".csv\"):\n",
        "    raise ValueError(\"Selecciona el ZIP de UCI o el archivo student-por.csv.\")\n",
        "\n",
        "df = pd.read_csv(BytesIO(contenido), sep=\";\")\n",
        "\n",
        "columnas_notas = [\"G1\", \"G2\", \"G3\"]\n",
        "faltantes = set(columnas_notas) - set(df.columns)\n",
        "if faltantes:\n",
        "    raise ValueError(f\"Faltan columnas en el CSV: {sorted(faltantes)}.\")\n",
        "\n",
        "if len(df) != 649:\n",
        "    raise ValueError(\n",
        "        f\"El archivo tiene {len(df)} filas. \"\n",
        "        \"Usa student-por.csv, que contiene 649 registros.\"\n",
        "    )\n",
        "\n",
        "notas = df[columnas_notas].apply(pd.to_numeric, errors=\"raise\")\n",
        "if not ((notas >= 0) & (notas <= NOTA_MAXIMA)).all().all():\n",
        "    raise ValueError(\"Hay notas ausentes o fuera del rango de 0 a 20.\")\n",
        "\n",
        "# G1 y G2 son las entradas. G3 se usa para construir la etiqueta.\n",
        "X = notas[[\"G1\", \"G2\"]].copy()\n",
        "y = notas[\"G3\"].lt(NOTA_MINIMA).astype(int).rename(\"Reprobado\")\n",
        "\n",
        "print(f\"Archivo leído: {nombre} | Registros: {len(df)}\")\n",
        "print(f\"Filas completamente idénticas para revisar: {df.duplicated().sum()}\")\n",
        "\n",
        "clases = y.map({0: \"Aprobado\", 1: \"Reprobado\"})\n",
        "conteo = clases.value_counts().reindex([\"Aprobado\", \"Reprobado\"], fill_value=0)\n",
        "\n",
        "display(pd.DataFrame({\n",
        "    \"Estudiantes\": conteo,\n",
        "    \"% del total\": (100 * conteo / len(y)).round(2),\n",
        "}))"
      ]
